{
  "name": "ai-usage-widget",
  "productName": "AIUsageWidget",
  "version": "1.0.23",
  "description": "Claude·Codex·Gemini 5시간/주간 사용량을 항상 위에 떠서 보여주는 위젯",
  "main": "main.js",
  "author": "kimju.zip",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "gen-assets": "node gen-assets.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@35.7.5": true
  },
  "build": {
    "appId": "zip.kimju.aiusagewidget",
    "productName": "AIUsageWidget",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "widget.html",
      "about.html",
      "strip.js",
      "strip-layout.js",
      "strip-win32.js",
      "strip-preload.js",
      "strip.html",
      "assets/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/lib/**",
      "!node_modules/koffi/*.md",
      "!node_modules/koffi/index.d.ts",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/koffi/build/koffi/win32_x64/*.{exp,lib}"
    ],
    "asarUnpack": [
      "node_modules/koffi/build/koffi/win32_x64/koffi.node"
    ],
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "AIUsageWidget-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "AI 사용량 위젯"
    }
  },
  "dependencies": {
    "koffi": "^2.15.1"
  }
}
